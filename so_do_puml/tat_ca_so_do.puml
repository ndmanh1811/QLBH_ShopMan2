@startuml
skinparam linetype ortho
hide circle

entity "tblMember2" as tblMember2 {
  * **id** : integer(10) <<PK>>
  --
  * username : varchar(255) <<UQ>>
  * password : varchar(255)
  * fullName : varchar(255)
  * address : varchar(255)
  * email : varchar(255) <<UQ>>
  * phone : varchar(50)
