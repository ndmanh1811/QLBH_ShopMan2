entity "ItemRevenueStat2" as StatEntity
entity "InvoiceDetail2" as DetailEntity

activate Manager
Manager -> HomeFrm : chọn xem thống kê
activate HomeFrm
HomeFrm -> TypeFrm : gọi
deactivate HomeFrm
activate TypeFrm
TypeFrm --> Manager : hiển thị
